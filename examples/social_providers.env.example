# Core social controls
SOCIAL_ENABLED=1
SOCIAL_PROVIDER_TIMEOUT_SECONDS=20
SOCIAL_LOOKBACK_HOURS=72
SOCIAL_BASELINE_DAYS=14
SOCIAL_MAX_POSTS_PER_SOURCE=150
SOCIAL_MIN_RECENT_POSTS=10
SOCIAL_MIN_UNIQUE_AUTHORS=5
SOCIAL_MIN_PLATFORM_COUNT=1
SOCIAL_MAX_AUTHOR_SHARE=0.40

# Reddit
REDDIT_ENABLED=1
REDDIT_SUBREDDITS=stocks,investing,wallstreetbets,options,SecurityAnalysis

# Public forums / Discourse
FORUM_ENABLED=0
FORUM_BASE_URLS=https://meta.discourse.org,https://community.fly.io
FORUM_MAX_POSTS_PER_FORUM=25
# FORUM_API_KEY=
# FORUM_API_USERNAME=

# X via twscrape
X_ENABLED=0
X_PROVIDER=twscrape,twikit
X_SEARCH_PRODUCT=Latest
X_MAX_POSTS=50
X_DB_PATH=data/state/twscrape_accounts.db
# X_PROXY_URL=http://user:pass@host:port
# X_ACCOUNTS_FILE=data/state/x_accounts.txt
# X_ACCOUNTS_LINE_FORMAT=username:password:email:email_password:_:cookies
# When both X_ACCOUNTS_FILE and X_DB_PATH are set, the project can bootstrap twscrape accounts.db on first run.

# X via twikit
# X_PROVIDER=twikit
# X_USERNAME=
# X_EMAIL=
# X_PASSWORD=
# X_EMAIL_PASSWORD=
# X_COOKIES_PATH=data/state/x_cookies.json

# Options / chain context
OPTIONS_ENABLED=0
OPTIONS_PROVIDER=alpha_vantage
OPTIONS_REQUIRE_GREEKS=0
OPTIONS_MAX_CONTRACTS=80
